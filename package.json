{
  "name": "nubblenh",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint-prettier": "prettier ./src --write && eslint ./src",
    "start": "react-native start",
    "test": "jest",
    "android-clean": "cd android && ./gradlew clean && rm -rf ./build && cd ..",
    "node-clean": "rm -rf yarn.lock && rm -rf bun.lockb && rm -rf node_modules",
    "pod-install": "cd ios && pod install && cd ../",
    "pod-clean": "rm -rf ~/Library/Caches/CocoaPods && cd ios && rm -rf ./Pods && rm -rf ./build && rm -rf ./Podfile.lock && pod cache clean --all && pod deintegrate && pod setup && pod install && cd ..",
    "generate-apk": "cd android && ./gradlew assembleRelease && cd app/build/outputs/apk/release && adb install app-release.apk && cd ../../../../"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@shopify/restyle": "^2.4.4",
    "@tanstack/react-query": "^5.59.20",
    "@types/jest": "^29.5.12",
    "axios": "^1.7.7",
    "date-fns": "^4.1.0",
    "react": "18.3.1",
    "react-hook-form": "^7.53.2",
    "react-native": "0.76.1",
    "react-native-mmkv": "^3.1.0",
    "react-native-safe-area-context": "^4.14.0",
    "react-native-screens": "^4.0.0",
    "react-native-svg": "^15.9.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.0",
    "@react-native-community/cli-platform-android": "15.0.0",
    "@react-native-community/cli-platform-ios": "15.0.0",
    "@react-native/babel-preset": "0.76.1",
    "@react-native/eslint-config": "^0.76.1",
    "@react-native/metro-config": "0.76.1",
    "@react-native/typescript-config": "0.76.1",
    "@tanstack/eslint-plugin-query": "^5.20.1",
    "@testing-library/react-native": "^12.4.5",
    "@tsconfig/react-native": "^3.0.0",
    "@types/metro-config": "^0.76.3",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-testing-library": "^6.2.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@3.8.6"
}
